{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UTMka 3.0",
  "version": "3.0.0",
  "identifier": "ru.alexpronin.utmka",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "UTMka — конструктор UTM-меток",
        "width": 1180,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMEY1NUQ3QjBDRTU0N0YKUldSL1ZNNncxMVVQenllQlJDRC9USUVoWXhKclFsN2wzWHVRZFJSK2ZBb28wMm16RWF4UHIzNE0K",
      "endpoints": [
        "https://github.com/Goryuchnick/UTMka-official-service/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Конструктор UTM-меток",
    "longDescription": "Собирает корректные UTM-ссылки и объясняет, что сломается в отчёте. Шаблоны, история, справочник значений и пакетный режим — локально, без интернета и регистрации.",
    "copyright": "© Александр Пронин",
    "publisher": "Александр Пронин",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "startMenuFolder": "UTMka"
      }
    }
  }
}
