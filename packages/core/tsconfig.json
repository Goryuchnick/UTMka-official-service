{
  "compilerOptions": {
    "target": "ES2022",
    // DOM здесь только ради типов URL и URLSearchParams — они есть и в браузере,
    // и в Node, и в Tauri. Ничего собственно DOM-ного ядро не трогает.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": ["src", "test"]
}
